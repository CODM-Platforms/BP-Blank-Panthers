# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL (Neon, etc). Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required only when running `npm run db:seed` (creates the 1 super admin +
# 3 clan masters). Set these locally (never commit them) before seeding.
# Clan Master One is the designated lead - see prisma/seed.ts.
SEED_SUPERADMIN_PASSWORD=""
SEED_MASTER1_PASSWORD=""
SEED_MASTER2_PASSWORD=""
SEED_MASTER3_PASSWORD=""
